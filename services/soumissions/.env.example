# Soumissions Service Environment Variables
# Copy this file to .env and customize as needed

# Django Settings
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=unsafe-dev-secret-key-soumissions-change-in-production

# Database (Shared Infrastructure)
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=soumissions_db
DB_USER=soumissions_user
DB_PASSWORD=soumissions_password

# Redis (Shared Infrastructure)
# DB index 9 is reserved for soumissions service
REDIS_URL=redis://:almizan_redis_password@host.docker.internal:6379/9

# MinIO Configuration (File Storage)
MINIO_HOST=host.docker.internal
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=soumissions
MINIO_USE_SSL=False

# Service Configuration
PORT=8000

# NGINX Ingress Port
SOUMISSIONS_NGINX_PORT=8004
