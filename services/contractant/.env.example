# Contractant Service Environment Variables
# Copy this file to .env and customize as needed

# Django Settings
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=unsafe-dev-secret-key-contractant-change-in-production

# Database (Shared Infrastructure)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=contractant_db
DB_USER=contractant_user
DB_PASSWORD=contractant_password

# Redis (Shared Infrastructure)
# DB index 4 is reserved for contractant service
REDIS_URL=redis://:almizan_redis_password@host.docker.internal:6379/4

# Service Configuration
PORT=8000

# NGINX Ingress Port
CONTRACTANT_NGINX_PORT=18082
