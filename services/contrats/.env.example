# Contrats Service Environment Variables
# Copy this file to .env and customize as needed

# Django Settings
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=unsafe-dev-secret-key-contrats-change-in-production

# Database (Shared Infrastructure)
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=contrats_db
DB_USER=contrats_user
DB_PASSWORD=contrats_password

# Redis (Shared Infrastructure)
# DB index 3 is reserved for contrats service
REDIS_URL=redis://:almizan_redis_password@host.docker.internal:6379/3

# Service Configuration
PORT=8000

# NGINX Ingress Port
CONTRATS_NGINX_PORT=18085
