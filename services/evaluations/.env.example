# Evaluations Service Environment Variables
# Copy this file to .env and customize as needed

# Django Settings
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=unsafe-dev-secret-key-evaluations-change-in-production

# Database (Shared Infrastructure)
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=evaluations_db
DB_USER=evaluations_user
DB_PASSWORD=evaluations_password

# Redis (Shared Infrastructure)
# DB index 5 is reserved for evaluations service
REDIS_URL=redis://:almizan_redis_password@host.docker.internal:6379/5

# Service Configuration
PORT=8000

# NGINX Ingress Port
EVALUATIONS_NGINX_PORT=18086
