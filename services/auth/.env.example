# Auth Service Environment Variables
# Copy this file to .env and customize as needed

# Django Settings
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=unsafe-dev-secret-key-change-in-production

# Database (Shared Infrastructure)
# These values connect to the shared PostgreSQL container
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=auth_db
DB_USER=auth_user
DB_PASSWORD=auth_password

# Redis (Shared Infrastructure)
# DB index 0 is reserved for auth service
REDIS_URL=redis://:almizan_redis_password@host.docker.internal:6379/0

# Service Configuration
PORT=8000

# NGINX Ingress Port
# This is the external port to access the service
AUTH_NGINX_PORT=18080

# Optional: Gunicorn Configuration
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=30
