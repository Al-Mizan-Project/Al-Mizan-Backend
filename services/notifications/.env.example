# Notifications Service Environment Variables
# Copy this file to .env and customize as needed

# Django Settings
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=unsafe-dev-secret-key-notifications-change-in-production

# Database (Shared Infrastructure)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=notifications_db
DB_USER=notifications_user
DB_PASSWORD=notifications_password

# Redis (Shared Infrastructure)
# DB index 6 is reserved for notifications service
REDIS_URL=redis://:almizan_redis_password@host.docker.internal:6379/6

# Service Configuration
PORT=8000

# NGINX Ingress Port
NOTIFICATIONS_NGINX_PORT=18087
