# IA Service Environment Variables
# Copy this file to .env and customize as needed

# Django Settings
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=unsafe-dev-secret-key-ia-change-in-production

# Database (Shared Infrastructure)
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=ia_db
DB_USER=ia_user
DB_PASSWORD=ia_password

# Redis (Shared Infrastructure)
# DB index 7 is reserved for ia service
REDIS_URL=redis://:almizan_redis_password@host.docker.internal:6379/7

# Service Configuration
PORT=8000

# NGINX Ingress Port
IA_NGINX_PORT=18088
