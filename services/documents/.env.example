# Documents Service Environment Variables
# Copy this file to .env and customize as needed

# Django Settings
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=unsafe-dev-secret-key-documents-change-in-production

# Database (Shared Infrastructure)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=documents_db
DB_USER=documents_user
DB_PASSWORD=documents_password

# Redis (Shared Infrastructure)
# DB index 8 is reserved for documents service
REDIS_URL=redis://:almizan_redis_password@host.docker.internal:6379/8

# MinIO Configuration (File Storage)
MINIO_HOST=host.docker.internal
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=False

# Service Configuration
PORT=8000

# NGINX Ingress Port
DOCUMENTS_NGINX_PORT=8003
