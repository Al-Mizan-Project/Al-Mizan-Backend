# Appels Service Environment Variables
# Copy this file to .env and customize as needed

# Django Settings
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=unsafe-dev-secret-key-appels-change-in-production

# Database (Shared Infrastructure)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=appels_db
DB_USER=appels_user
DB_PASSWORD=appels_password

# Redis (Shared Infrastructure)
# DB index 2 is reserved for appels service
REDIS_URL=redis://:almizan_redis_password@host.docker.internal:6379/2

# Service Configuration
PORT=8000

# NGINX Ingress Port
APPELS_NGINX_PORT=18083
