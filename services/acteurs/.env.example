# Acteurs Service Environment Variables
# Copy this file to .env and customize as needed

# Django Settings
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=unsafe-dev-secret-key-acteurs-change-in-production

# Database (Shared Infrastructure)
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=acteurs_db
DB_USER=acteurs_user
DB_PASSWORD=acteurs_password

# Redis (Shared Infrastructure)
# DB index 1 is reserved for acteurs service
REDIS_URL=redis://:almizan_redis_password@host.docker.internal:6379/1

# Service Configuration
PORT=8000

# NGINX Ingress Port
ACTEURS_NGINX_PORT=18081
