# =============================================================================
# Al-Mizan Shared Infrastructure Environment Variables
# Copy this file to .env and customize values for your environment
# =============================================================================

# PostgreSQL Admin (superuser for creating databases)
POSTGRES_ADMIN_USER=almizan_admin
POSTGRES_ADMIN_PASSWORD=almizan_admin_password
POSTGRES_PORT=5433  # Use 5433 to avoid conflicts with local PostgreSQL installations

# Redis
REDIS_PASSWORD=almizan_redis_password
REDIS_PORT=6379

# =============================================================================
# Service Database Credentials
# Each service has its own database and user within the shared PostgreSQL
# =============================================================================

# Auth Service
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password

# Acteurs Service
ACTEURS_DB_NAME=acteurs_db
ACTEURS_DB_USER=acteurs_user
ACTEURS_DB_PASSWORD=acteurs_password

# Appels Service
APPELS_DB_NAME=appels_db
APPELS_DB_USER=appels_user
APPELS_DB_PASSWORD=appels_password

# Audit Service
AUDIT_DB_NAME=audit_db
AUDIT_DB_USER=audit_user
AUDIT_DB_PASSWORD=audit_password

# Contractant Service
CONTRACTANT_DB_NAME=contractant_db
CONTRACTANT_DB_USER=contractant_user
CONTRACTANT_DB_PASSWORD=contractant_password

# Contrats Service
CONTRATS_DB_NAME=contrats_db
CONTRATS_DB_USER=contrats_user
CONTRATS_DB_PASSWORD=contrats_password

# Documents Service
DOCUMENTS_DB_NAME=documents_db
DOCUMENTS_DB_USER=documents_user
DOCUMENTS_DB_PASSWORD=documents_password

# Evaluations Service
EVALUATIONS_DB_NAME=evaluations_db
EVALUATIONS_DB_USER=evaluations_user
EVALUATIONS_DB_PASSWORD=evaluations_password

# IA Service
IA_DB_NAME=ia_db
IA_DB_USER=ia_user
IA_DB_PASSWORD=ia_password

# Notifications Service
NOTIFICATIONS_DB_NAME=notifications_db
NOTIFICATIONS_DB_USER=notifications_user
NOTIFICATIONS_DB_PASSWORD=notifications_password

# Soumissions Service
SOUMISSIONS_DB_NAME=soumissions_db
SOUMISSIONS_DB_USER=soumissions_user
SOUMISSIONS_DB_PASSWORD=soumissions_password

# Recours Service (future)
RECOURS_DB_NAME=recours_db
RECOURS_DB_USER=recours_user
RECOURS_DB_PASSWORD=recours_password
