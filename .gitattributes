# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must use LF (Unix line endings)
*.sh text eol=lf

# Explicitly declare text files you want to always be normalized and converted to LF
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf

# Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
